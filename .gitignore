# Kami agent worktrees are created inside the served tree by default, and a
# nested checkout breaks the HTML shell: bunfig serves pages through
# bun-plugin-tailwind, whose source scan skips only gitignored paths, so it
# compiles the nested copy too and the whole page bundle fails silently.
.kami-worktrees/

# The served instance's routing table is runtime state, not source: a checkout
# must never clobber the table an instance is actually serving.
data/routes.json
